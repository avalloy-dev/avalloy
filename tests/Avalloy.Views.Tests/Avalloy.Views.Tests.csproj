<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Microsoft Testing Platform + MSTest, matching the other suites. The ONE Avalloy suite on
         Avalonia.Headless: views only, for what exists only once a control is laid out, focused and keyed
         (fit to width, keys routed through the palette, scroll into view, automation names). Everything a
         view model decides stays in Avalloy.Base.Tests, which needs no renderer.
         Every headless test must RETURN the Task from Session.Dispatch: a test that discards it passes
         without its body having run. -->
    <EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformCommandLineArguments>--timeout 60s</TestingPlatformCommandLineArguments>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalloy.Desktop\Avalloy.Desktop.csproj" />
  </ItemGroup>
</Project>
