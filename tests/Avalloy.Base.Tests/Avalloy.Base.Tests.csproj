<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Microsoft Testing Platform + MSTest, matching the other suites.
         Avalloy.Base: preferences (in memory through MockFileSystem, plus a few real-disk file watcher
         and file-mode tests), the keymap engine and the command palette's view model, which holds every
         decision the user can observe. Only KeymapRoutedTests needs Avalonia.Headless, for routed key
         events; everything else runs without a dispatcher. -->
    <EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <!-- A hang guard, not a budget: the real-disk watcher tests wait on file system notifications. -->
    <TestingPlatformCommandLineArguments>--timeout 60s</TestingPlatformCommandLineArguments>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Base references only the DI abstractions; the dispatcher and palette tests build a real container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="23.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalloy.Base\Avalloy.Base.csproj" />
  </ItemGroup>
</Project>
