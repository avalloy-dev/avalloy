<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avalloy.Starter.App"
             Name="Avalloy Starter"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <!-- The native theme contract from Avalloy.Desktop: the type ramp, the token-driven
             style classes (.card/.actionbtn/.bare/seg2/…), and the popover + dropdown-row
             vocabulary (.popoverframe/.popovercard/.ddrow/…). -->
        <StyleInclude Source="avares://Avalloy.Desktop/Themes/Type.axaml" />
        <StyleInclude Source="avares://Avalloy.Desktop/Themes/ControlStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme-independent tokens (fonts/sizes/radii/shadow room). The active per-variant
                     palette (Template.Light/Dark, or your own copy of them) is swapped in at runtime
                     by NativeThemeController. -->
                <ResourceInclude Source="avares://Avalloy.Desktop/Themes/Tokens.axaml" />
                <!-- ControlThemes for the Alloy control layer (AlloyDropDown/AlloySelect/AlloyTextBox/DrawerPull). -->
                <ResourceInclude Source="avares://Avalloy.Desktop/Themes/AlloyControls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
