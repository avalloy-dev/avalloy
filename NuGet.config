<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- nuget.org only. Everything this repo builds against is public, so a fresh clone on a
         machine with no secrets restores, builds and tests. Never add a credential here.
         Releases push by URL with the write key from the environment, not through this file. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
