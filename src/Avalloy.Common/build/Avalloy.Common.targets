<Project>
  <!--
    Auto-imported by NuGet for anyone referencing the Avalloy.Common package (the
    build/<PackageId>.targets convention). Until 0.23.0 it shipped in Avalloy.Icons.
    build/ assets are not transitive, so an app that gets Common through Avalloy.Base
    or Avalloy.Desktop and bakes its own packs references Avalloy.Common directly; a
    project that declares no <IconPack> is untouched. This is the PACKAGE-mode twin of the
    repo-internal build/iconpacks.targets: same <IconPack> item contract, but it
    invokes the baker as an INSTALLED DOTNET TOOL rather than by running the tool
    project from source, because a package consumer has no Avalloy.IconTool project
    to point at.

    (Careful editing this comment: a literal double-hyphen is illegal inside an XML
    comment, and MSBuild only parses this file once it is inside a consumer's package
    cache — so a stray one builds fine here and breaks every consumer.)

      <ItemGroup>
        <IconPack Include="lucide">
          <Name>Lucide</Name>
          <SrcDir>$(MSBuildProjectDirectory)\Assets\iconpacks\lucide</SrcDir>
          <OutDir>$(MSBuildProjectDirectory)\Assets\iconpacks\lucide</OutDir>
          <DuoDir></DuoDir>            (optional: parallel dir of lit duotone layers)
          <Roles></Roles>              (optional: an icons.md role table for curated aliases)
          <Description>Lucide (ISC)</Description>
          <Homepage>https://lucide.dev</Homepage>
          <Version>0.2.0</Version>
        </IconPack>
        <IconPackInput Include="$(MSBuildProjectDirectory)\Assets\iconpacks\lucide\*.svg" />
      </ItemGroup>

    Requires the baker to be in the project's tool manifest:
      dotnet new tool-manifest
      dotnet tool install Avalloy.IconTool

    Baked outputs are meant to be checked in, so this only fires when a pack's SVGs
    actually change. Unlike the in-repo targets, Inputs deliberately lists ONLY the
    consumer's own SVGs — the platform source files the in-repo version watches don't
    exist here, and naming missing files as Inputs makes MSBuild rebuild every time.
    The tool's own version is pinned in the manifest, so a tool upgrade is an explicit
    act; re-bake by touching the SVGs or deleting the baked output.
  -->

  <Target Name="BakeIconPacks"
          BeforeTargets="BeforeBuild"
          Condition="'@(IconPack)' != '' And '$(SkipBakeIconPacks)' != 'true'"
          Inputs="@(IconPackInput)"
          Outputs="@(IconPack->'%(OutDir)\%(Identity).icons.axaml')">
    <Message Importance="high" Text="Baking icon pack '%(IconPack.Identity)' from %(IconPack.SrcDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet tool run avalloy-icontool -- create --id %(IconPack.Identity) --name &quot;%(IconPack.Name)&quot; --src &quot;%(IconPack.SrcDir)&quot; --out &quot;%(IconPack.OutDir)&quot; --duo &quot;%(IconPack.DuoDir)&quot; --roles &quot;%(IconPack.Roles)&quot; --desc &quot;%(IconPack.Description)&quot; --homepage &quot;%(IconPack.Homepage)&quot; --version &quot;%(IconPack.Version)&quot;" />
  </Target>

</Project>
